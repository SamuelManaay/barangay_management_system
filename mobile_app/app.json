{
  "expo": {
    "name": "Barangay Management System",
    "slug": "barangay-management-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "brgyapp",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barangay.residentapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e40af",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.barangay.residentapp",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6e5e8c58-85cc-4128-b873-992dd0e41953"
      }
    }
  }
}
